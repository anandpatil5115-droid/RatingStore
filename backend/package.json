{
  "name": "store-rating-backend",
  "version": "1.0.0",
  "description": "REST API for the Store Rating application (Express + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev --name init && node prisma/seed.js"
  },
  "keywords": ["store", "rating", "express", "prisma", "postgresql"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
